# Names the claims chapter cites that live in an open Core merge request
# rather than on main: one per line, name first, then the MR that carries
# it. check-claim-names.sh reports them as PENDING instead of failing, and
# fails once the name is on main so the line is removed (ratchet).
a_qr_session_stores_the_exchange_timestamp core!2125
in_a_mutual_qr_exchange_one_side_emits_first_and_the_other_listens_first core!2125
a_confirmed_medium_proximity_is_not_lowered_by_the_key_agreement_check core!2125
a_glance_displayer_refuses_an_offer_after_its_own_sixty_second_window core!2125
qr_auto_advance_names_the_contact_after_the_peer_qr core!2125
