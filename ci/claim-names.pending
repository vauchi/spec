# Names the claims chapter cites that live in an open Core merge request
# rather than on main: one per line, name first, then the MR that carries
# it. check-claim-names.sh reports them as PENDING instead of failing, and
# fails once the name is on main so the line is removed (ratchet).
begin_recovery core!2187
hand_back_in_person core!2187
take_hand_back core!2187
restore_identity_from_hand_backs core!2187
